# Create a dedicated Discord application and install its bot in your server.
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=

# Optional reference only: Gateway commands do not use the application's public key.
DISCORD_PUBLIC_KEY=

# Optional: register commands immediately in one server instead of globally.
DISCORD_GUILD_ID=

# Optional settings. No AI account is required for ordinary RFD alerts.
RFD_POLL_INTERVAL=3m
RFD_POLL_TIMEOUT=4m
DISCORD_UPDATE_INTERVAL=10m
MAX_STORED_DEALS=2000
LOG_LEVEL=INFO

# Optional title cleanup: supply your own API key and supported Gemini model IDs.
GEMINI_API_KEY=
# Example current lightweight model: gemini-3.5-flash-lite (verify account access).
GEMINI_MODELS=

# Optional affiliate settings. Blank means direct links with no personal tags.
AMAZON_AFFILIATE_TAG=
BESTBUY_AFFILIATE_PREFIX=
